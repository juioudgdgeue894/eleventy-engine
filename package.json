{
  "name": "@jacklamond/eleventy-engine",
  "version": "1.21.2",
  "description": "Shared Eleventy engine \u2014 layouts, partials, SEO scaffolding, component library and UK compliance \u2014 for client websites.",
  "type": "commonjs",
  "main": "eleventy.js",
  "exports": {
    ".": "./eleventy.js",
    "./eleventy": "./eleventy.js",
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "bin": {
    "eleventy-engine-sync": "bin/sync.mjs"
  },
  "scripts": {
    "sync:all": "node bin/sync-all.mjs",
    "release": "node bin/release.mjs",
    "launch:platform": "node bin/launch-platform.mjs",
    "email:check": "node bin/email-check.mjs"
  },
  "files": [
    "eleventy.js",
    "tailwind-preset.js",
    "bin/",
    "_includes/",
    "pages/",
    "css/",
    "functions/",
    "worker/",
    "CLAUDE.shared.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^7.1.1",
    "concurrently": "^9.2.5",
    "flowbite": "^2.5.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.13"
  }
}
