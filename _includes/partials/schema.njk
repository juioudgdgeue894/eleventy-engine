{#- JSON-LD structured data. LocalBusiness always renders. FAQPage renders only
   for the business.faq questions that are actually in this page's text (Google
   requires marked-up FAQ content to be visible on the same page), so a page
   without the FAQ block gets no FAQ schema.
   Every value goes through the `dump` filter (JSON.stringify) rather than
   manual quoting, so apostrophes/quotes in client data can't break the JSON.
   Empty optional fields are left out rather than emitted as "".
   business.seo.logo (a path like /images/logo.png) sets `logo`; without it the
   share image is used. -#}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": {{ business.seo.schema_type | dump | safe }},
  "name": {{ (business.seo.schema_name or business.business_name) | dump | safe }},
  "description": {{ (business.description or "") | dump | safe }},
  "url": {{ business.seo.site_url | dump | safe }},
  {% if business.contact.phone %}"telephone": {{ (business.contact.phone_intl or business.contact.phone) | dump | safe }},
  {% endif %}{% if business.contact.email %}"email": {{ business.contact.email | dump | safe }},
  {% endif %}{% if business.contact.phone or business.contact.email %}"contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    {% if business.contact.phone %}"telephone": {{ (business.contact.phone_intl or business.contact.phone) | dump | safe }},
    {% endif %}{% if business.contact.email %}"email": {{ business.contact.email | dump | safe }},
    {% endif %}"url": {{ (business.seo.site_url + (business.contact.page or "/contact/")) | dump | safe }}
  },
  {% endif %}{% if business.address.map_url %}"hasMap": {{ business.address.map_url | dump | safe }},
  {% endif %}
  "logo": {{ (business.seo.site_url + (business.seo.logo or business.seo.og_image)) | dump | safe }},
  "image": {{ (business.seo.site_url + business.seo.og_image) | dump | safe }},
  {% if business.service_areas.enabled and towns and towns.length %}"areaServed": [
    {% for town in towns %}{{ town.name | dump | safe }}{% if not loop.last %}, {% endif %}{% endfor %}
  ],
  {% endif %}{% if business.seo.price_range %}
  "priceRange": {{ business.seo.price_range | dump | safe }},{% endif %}
  "address": {
    "@type": "PostalAddress",
    {% if business.address.line1 %}"streetAddress": {{ business.address.line1 | dump | safe }},
    {% endif %}{% if business.address.city %}"addressLocality": {{ business.address.city | dump | safe }},
    {% endif %}{% if business.address.region %}"addressRegion": {{ business.address.region | dump | safe }},
    {% endif %}{% if business.address.postcode %}"postalCode": {{ business.address.postcode | dump | safe }},
    {% endif %}"addressCountry": "GB"
  }{% if business.seo.geo %},
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ business.seo.geo.latitude }},
    "longitude": {{ business.seo.geo.longitude }}
  }{% endif %}{% if business.seo.opening_hours and business.seo.opening_hours.length %},
  "openingHours": {{ business.seo.opening_hours | dump | safe }}{% endif %}{% if business.social and business.social.length %},
  "sameAs": {{ business.social | pluck("url") | dump | safe }}{% endif %}
}
</script>

{#- `content` is this page's rendered body. A question counts as shown when its
   escaped text is in it (templates print {{ item.question }} with autoescape on). -#}
{%- set _faqShown = [] -%}
{%- if content and business.faq and business.faq.length -%}
  {%- for item in business.faq -%}
    {%- if (item.question | escape | string) in (content | string) -%}{%- set _pushed = _faqShown.push(item) -%}{%- endif -%}
  {%- endfor -%}
{%- endif -%}
{% if _faqShown.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in _faqShown %}
    {
      "@type": "Question",
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | dump | safe }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
